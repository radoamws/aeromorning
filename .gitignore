# Environment / secrets (per-environment, differs between local and prod)
wp-config.php
.htaccess
.htaccess.bk
.user.ini
php.ini
.ftpquota
wp-content/mu-plugins/local-dev-overrides.php

# WordPress runtime / generated data (not source, regenerated automatically)
wp-content/uploads/
wp-content/upgrade/
wp-content/upgrade-temp-backup/
wp-content/cache/
wp-content/gallery/*/cache/
wp-content/litespeed/
wp-content/ewww/
wp-content/debug.log
*.log

# Generated at request time by wp-content/plugins/llm-txt (never written as a
# static file anymore — see that plugin's comment for why a static file per
# multisite blog can't work here).
/llm.txt

# Private stats tool (contains .htpasswd)
/stat/

# Session scratch files
prompt

# OS junk
Thumbs.db
.DS_Store
.env
